93221200000,"endsAt":1793226096000,"done":true,"who":"him"},"windowbox":{"startedAt":1793239200000,"endsAt":1793242872000,"done":true},"heal:0,1:3":{"startedAt":1793239200000,"endsAt":1793241648000,"done":true,"who":"him"},"nameboard":{"startedAt":1793260800000,"endsAt":1793262636000,"done":false,"who":"her"},"wildflowers":{"startedAt":1793260800000,"endsAt":1793262432000,"done":false,"who":"him"}},"offers":[],"journal":{"spirit":{"first":1792616400000,"count":1,"fed":[],"helped":0}},"arrived":{},"feeder":{"food":"seed","at":1792616640000,"who":null,"comeAt":1792617087935.5981},"deeds":{"day":"","n":0},"log":[{"t":1793221200000,"text":"Breakfast from the pantry."},{"t":1793221200000,"text":"The rain barrel filled, and its water went into the store."},{"t":1793221200000,"text":"A short, loud storm. The roof held. They counted the thunder together."},{"t":1793221200000,"text":"The wind carried in a handful of seeds from somewhere green."},{"t":1793221200000,"text":"Hazel picked carrots. Into the pantry they go, and the ground remembers a little more of how to grow."},{"t":1793221200000,"text":"The pantry shelf was full, so the spare carrots went on the compost heap, and a few to the rabbit."},{"t":1793221200000,"text":"Hazel sowed lettuces across the bed. They want water."},{"t":1793221200000,"text":"Wendel watered the bed. Now it grows."},{"t":1793221200000,"text":"A warm hush over the bed, and lettuces fill out all at once."},{"t":1793221200000,"text":"Lettuces are ready to pick."},{"t":1793221200000,"text":"Hazel set to work: raise the roof and chimney."},{"t":1793221200000,"text":"Wendel set to work: fork the trampled ground."},{"t":1793221320000,"text":"Hazel picked lettuces. Into the pantry they go, and the ground remembers a little more of how to grow."},{"t":1793221320000,"text":"The pantry shelf was full, so the spare lettuces went on the compost heap, and a few to the rabbit."},{"t":1793221320000,"text":"Hazel sowed beans across the bed. They want water."},{"t":1793221320000,"text":"Wendel watered the bed. Now it grows."},{"t":1793239200000,"text":"Hazel finished: raise the roof and chimney."},{"t":1793239200000,"text":"Wendel finished: fork the trampled ground."},{"t":1793239200000,"text":"Something new to do: hang a window box."},{"t":1793239200000,"text":"The owl has moved into the owl box. The land is the better for it."},{"t":1793239200000,"text":"A new page in the animals' stories: An owl box."},{"t":1793239200000,"text":"Somewhere in the hedge, very small birds have started asking for breakfast all day long."},{"t":1793239200000,"text":"Hazel set to work: hang a window box."},{"t":1793239200000,"text":"Wendel set to work: water the forked earth."},{"t":1793260800000,"text":"Beans are ready to pick."},{"t":1793260800000,"text":"Hazel finished: hang a window box."},{"t":1793260800000,"text":"Wendel finished: water the forked earth."},{"t":1793260800000,"text":"Supper from the pantry."},{"t":1793260800000,"text":"The rain barrel filled, and its water went into the store."},{"t":1793260800000,"text":"Old seeds that had waited years in the hard ground have woken in the soft wet earth. There is a haze of green by the old rubbish heap."},{"t":1793260800000,"text":"The old rubbish heap is now first green."},{"t":1793260800000,"text":"The two of them took tea on the bench and watched the light change."},{"t":1793260800000,"text":"A breeze rattled the trees and dropped some twigs by the door."},{"t":1793260800000,"text":"Hazel picked beans. Into the pantry they go, and the ground remembers a little more of how to grow."},{"t":1793260800000,"text":"The pantry shelf was full, so the spare beans went on the compost heap, and a few to the rabbit."},{"t":1793260800000,"text":"Hazel sowed carrots across the bed. They want water."},{"t":1793260800000,"text":"Wendel watered the bed. Now it grows."},{"t":1793260800000,"text":"Hazel set to work: a name board over the door."},{"t":1793260800000,"text":"Wendel set to work: a wildflower patch."},{"t":1793260800000,"text":"Something new to do: build a leaf-pile shelter."}],"spellsUsed":{"coax":"2026-10-29"},"flags":{"r6":true,"welcomed":true,"rabbit":true,"picked:carrot":true,"firstpick":true,"picked:lettuce":true,"sown:pumpkin":true,"pumpkinYear":2026,"picked:pumpkin":true,"pumpkin":true,"picked:bean":true,"owlHome":1793239200000,"garden":true},"events":{"lastAt":1793260800000,"seen":{"drizzle":3,"dance":2,"wattle":1,"breeze":4,"storm":5,"tea":3,"berries":1,"blossom":3,"firefly":1,"gift":1,"neighbours":1,"seedwind":1,"chicks":1}},"story":{"chapter":0,"flags":{},"found":[]},"village":{"traveller":null,"nextAt":0,"queue":["mabel","tobias","fernsby","pebbleworth","clem","barnaby","nettle","juniper"],"folk":{},"favour":null,"favourAt":1793282400000,"finds":[]},"secrets":{"found":{},"out":[{"id":"bower","tile":"0,0","gx":0.19192899700417015,"gy":0.5780409079126545},{"id":"bluefeather","tile":"0,0","gx":0.4216496181987046,"gy":0.8273876835130431}],"nextAt":1792715116867.2847},"season":"spring","festival":{"stage":"waiting","tile":null,"at":0,"day":"","years":[]},"pages":{"seen":{"1.1":1792530000000,"1.2":1792530360000,"1.3":1792616400000,"1.4":1792616400000,"1.5":1792616400000,"2.1":1792616400000,"2.2":1792634400000,"2.3":1792656000000,"2.4":1792702800000,"2.5":1793134800000,"3.0":1793134800000,"3.1":1793260800000},"cards":[],"makes":{"yard:barren":1792616400000,"yard:green":1792656000000,"yard:meadow":1792789200000,"yard:wood":1793048400000,"garden:green":1793260800000}},"spirit":{"taught":{"1":1792616400000,"2":1792702800000,"3":1793260800000}},"moved":{"owlbox":1793239200000},"animals":{"done":{"owlHome":1793239200000},"day":"2026-10-29","rabbitFed":[],"gifts":{},"giftDue":{}},"friends":{},"offered":{"doorstep":1792616400000,"beanpoles":1792634400000,"clothesline":1792656000000,"rainbarrel":1792702800000,"herbs":1792720800000,"compost":1792742400000,"springring":1792742400000,"greatgrove":1793048400000,"path":1793134800000,"wildmeadow":179315280000